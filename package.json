{
  "name": "biblioteca-pessoal",
  "version": "1.0.0",
  "description": "CRUD de biblioteca pessoal de livros (Express + Sequelize + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": {
      "global": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 }
    }
  }
}
